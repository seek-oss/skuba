{
  "name": "@skuba-lib/changesets-changelog",
  "version": "1.0.1",
  "private": false,
  "description": "Opinionated changelog generator for Changesets",
  "homepage": "https://github.com/seek-oss/skuba/tree/main/packages/changesets-changelog#readme",
  "bugs": {
    "url": "https://github.com/seek-oss/skuba/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seek-oss/skuba.git",
    "directory": "packages/changesets-changelog"
  },
  "bin": {
    "skuba-changelog-inject": "./src/inject.ts"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@seek/skuba/source": "./src/index.ts",
      "default": "./lib/index.mjs"
    },
    "./inject": {
      "@seek/skuba/source": "./src/inject.ts",
      "default": "./lib/inject.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "skuba-changelog-inject": "./lib/inject.mjs"
    },
    "exports": {
      ".": "./lib/index.mjs",
      "./inject": "./lib/inject.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "pnpm skuba build-package",
    "inject": "node ./lib/inject.mjs",
    "prepack": "pnpm build",
    "skuba": "node ../../lib/skuba",
    "test": "pnpm skuba test",
    "test:ci": "pnpm skuba test --coverage"
  },
  "dependencies": {
    "@changesets/get-github-info": "^1.0.0",
    "@changesets/types": "^7.0.0"
  },
  "devDependencies": {
    "@changesets/parse": "^1.0.0"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "skuba": {
    "entryPoint": "src/index.ts",
    "template": "oss-npm-package",
    "type": "package",
    "version": "16.3.0"
  }
}
