{
  "compilerOptions": {
    "skipLibCheck": true, // tsdown has optional peer deps
    "rootDir": ".",
    "declaration": true,
    "lib": ["ES2025", "ESNext.Array", "ESNext.Disposable", "ESNext.Error"],
    "outDir": "lib",
    "removeComments": false,
    "target": "ES2025"
  },
  "exclude": ["lib*/**/*"],
  "extends": "../../config/tsconfig.json"
}
