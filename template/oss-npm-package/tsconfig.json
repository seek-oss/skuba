{
  "compilerOptions": {
    "customConditions": ["@seek/<%- repoName %>/source"],
    "rootDir": ".",
    "lib": ["ES2025"],
    "outDir": "lib",
    "removeComments": false,
    "target": "ES2025",
    "skipLibCheck": true // tsdown has optional peer deps
  },
  "exclude": ["lib*/**/*"],
  "extends": "skuba/config/tsconfig.json"
}
