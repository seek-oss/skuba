{
  "compilerOptions": {
    "customConditions": ["@seek/<%- repoName %>/source"],
    "rootDir": ".",
    "lib": [
      "ES2025",
      "ESNext.Array",
      "ESNext.Collection",
      "ESNext.Date",
      "ESNext.Disposable",
      "ESNext.Error",
      "ESNext.Intl",
      "ESNext.SharedMemory",
      "ESNext.Temporal",
      "ESNext.TypedArrays"
    ],
    "outDir": "lib",
    "target": "ES2025"
  },
  "exclude": ["lib*/**/*"],
  "extends": "skuba/config/tsconfig.json"
}
